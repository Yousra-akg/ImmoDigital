@startuml ImmoDirect_Sprint2_Avance
skinparam actorStyle awesome
left to right direction

skinparam package {
    BackgroundColor White
    BorderColor #2C3E50
}

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #2E86C1
}

actor "Utilisateur" as U
actor "Agent" as Ag
actor "Administrateur" as Admin

package "ImmoDirect - Sprint 2 (Fonctionnalités Avancées)" {

    ' === Espace Utilisateur ===
    usecase "Recevoir confirmation automatique" as UC1
    usecase "Ajouter un bien aux favoris" as UC2
    usecase "Consulter ses favoris" as UC3

    U -- UC1
    U -- UC2
    U -- UC3

    ' === Espace Agent ===
    usecase "Accéder à 'Mes Missions'" as UC4
    usecase "Gérer le statut des actions" as UC5
    usecase "Noter commentaires & historique" as UC6

    Ag -- UC4
    Ag -- UC5
    Ag -- UC6

    ' === Espace Administrateur ===
    usecase "Assigner formulaires aux agents" as UC7
    usecase "Valider les propositions de vente" as UC8
    usecase "Consulter statistiques globales" as UC9
    usecase "Gérer les comptes agents" as UC10

    Admin -- UC7
    Admin -- UC8
    Admin -- UC9
    Admin -- UC10
}
@enduml